/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>
#include "mt6755.dtsi"

/ {
	/* LK принудительно заменяет /model */
	model = "Meizu M5 Note";
	compatible = "meizu,m5note", "mediatek,mt6755";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "framebuffer0";

		/* значения сняты с живого Android: fb_base 0x7e800000, stride 4352 */
		framebuffer0: framebuffer@9e420000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x9e420000 0x0 0x7f8000>;
			width = <1080>;
			height = <1920>;
			stride = <((1080 + 8) * 4)>;
			format = "a8r8g8b8";
		};
	};

	/* /reserved-memory должен существовать, иначе LK недоволен */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* то же, что LK резервирует в cmdline (mrdump) и в стоковом DTB (ATF) */
		atf@44600000 {
			reg = <0x0 0x44600000 0x0 0x40000>;
			no-map;
		};
		mrdump1@44000000 {
			reg = <0x0 0x44000000 0x0 0x200000>;
			no-map;
		};
		mrdump2@44800000 {
			reg = <0x0 0x44800000 0x0 0xe0000>;
			no-map;
		};
		mrdump3@46000000 {
			reg = <0x0 0x46000000 0x0 0x400000>;
			no-map;
		};

		ccci-md1 {
			no-map;
			size = <0x00 0xa100000>;
			alignment = <0x00 0x2000000>;
			alloc-ranges = <0x00 0x40000000 0x00 0xc0000000>;
		};
		ccci-share {
			no-map;
			size = <0x00 0x600000>;
			alignment = <0x00 0x4000000>;
			alloc-ranges = <0x00 0x40000000 0x00 0xc0000000>;
		};
		spm {
			no-map;
			size = <0x00 0x20000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x60000000>;
		};
		consys {
			no-map;
			size = <0x00 0x100000>;
			alignment = <0x00 0x200000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x60000000>;
		};
	};

	/* заглушка: LK сам подставляет реальные диапазоны памяти */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0xc0000000>;
	};
};

&uart0 {
	status = "okay";
};

/* eMMC (msdc0): LK уже инициализировал контроллер, такты берём фиксированные */
/ {
	msdc0_src: clock-msdc0-src {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <400000000>;
	};

	msdc0_hclk: clock-msdc0-hclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	mmc0: mmc@11230000 {
		compatible = "mediatek,mt8173-mmc";
		reg = <0x0 0x11230000 0x0 0x1000>;
		interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&msdc0_src>, <&msdc0_hclk>;
		clock-names = "source", "hclk";
		pinctrl-names = "default", "state_uhs";
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		bus-width = <8>;
		max-frequency = <50000000>;
		cap-mmc-highspeed;
		non-removable;
		no-sd;
		no-sdio;
		status = "okay";
	};
};


/* питание eMMC: LK его уже включил, ядру только сообщаем напряжение */
/ {
	reg_emmc_3v3: regulator-emmc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "emmc_vcc_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&mmc0 {
	vmmc-supply = <&reg_emmc_3v3>;
};

/* USB (SSUSB/mtu3) только в режиме устройства; такты и питание: LK уже включил */
/ {
	usb_clk26m: clock-usb-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	reg_usb_3v3: regulator-usb-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "usb_avdd33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	u3phy: t-phy@11290000 {
		compatible = "mediatek,generic-tphy-v1";
		reg = <0x0 0x11290000 0x0 0x800>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		status = "okay";

		u2port0: usb-phy@11290800 {
			reg = <0x0 0x11290800 0x0 0x100>;
			clocks = <&usb_clk26m>;
			clock-names = "ref";
			#phy-cells = <1>;
			status = "okay";
		};
	};

	usb_dev: usb@11271000 {
		compatible = "mediatek,mt8173-mtu3";
		reg = <0x0 0x11271000 0x0 0x3000>, <0x0 0x11280700 0x0 0x100>;
		reg-names = "mac", "ippc";
		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_LOW>;
		phys = <&u2port0 PHY_TYPE_USB2>;
		clocks = <&usb_clk26m>, <&usb_clk26m>;
		clock-names = "sys_ck", "ref_ck";
		vusb33-supply = <&reg_usb_3v3>;
		dr_mode = "peripheral";
		maximum-speed = "high-speed";
		status = "okay";
	};
};
